import OpConjecture.RadicalSquareZero.SeparatedSimpleClosure
import OpConjecture.RadicalSquareZero.SkeletonTraceBridge
import OpConjecture.RepresentationTheory.SeparatedTriangularAlgebra
import OpConjecture.RepresentationTheory.SeparatedTriangularTrace

/-!
# The free separated simple is not generated by nonsimples

A nonsimple separated representation is generated by its top under the
arrow action.  Any morphism from such data to a representation with zero top
therefore vanishes: compatibility kills every action generator of the source
radical.  After realization over the triangular separated algebra, this
proves that the radical-side (free) simple copy never lies in the quotient
closure of selected nonsimples.
-/

set_option autoImplicit false

noncomputable section

open Set
open CategoryTheory

namespace OpConjecture.RadicalSquareZero

open RadicalSquareZeroCombinatorics.CoreFamily.TopCoverage
open TrivSqZeroExtSeparatedData
open SeparatedTriangularAlgebra

universe u v w x y

variable {S : Type u} {J : Type v}
variable [CommRing S] [AddCommGroup J]
variable [Module S J] [Module Sᵐᵒᵖ J]
variable [SMulCommClass S Sᵐᵒᵖ J]
variable [IsNoetherianRing (Algebra S J)]
variable {Nonsimple : Type x} {Vertex : Type y}
  [Fintype Nonsimple] [Fintype Vertex]
variable
  {tau : IndecomposableSkeleton.{max u v, max x y, w}
    (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex))}

/-- Realization data sufficient to identify the nonsimple labels and the
free simple copy in an actual triangular-algebra skeleton. -/
structure SeparatedNonsimpleFreeData
    (tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex))) where
  nonsimpleData : Nonsimple →
    SeparatedData.{u, v, w} (S := S) (J := J)
  nonsimple_generated (z : Nonsimple) :
    IsGenerated (nonsimpleData z)
  nonsimple_iso (z : Nonsimple) :
    realizedModuleCat (nonsimpleData z) ≅
      (forget₂ (FGModuleCat.{w} (Algebra S J))
        (ModuleCat.{w} (Algebra S J))).obj (tau.obj (Sum.inl z))
  freeData : Vertex → SeparatedData.{u, v, w} (S := S) (J := J)
  free_top_subsingleton (v : Vertex) : Subsingleton (freeData v).top
  free_iso (v : Vertex) :
    realizedModuleCat (freeData v) ≅
      (forget₂ (FGModuleCat.{w} (Algebra S J))
        (ModuleCat.{w} (Algebra S J))).obj
          (tau.obj (Sum.inr (Sum.inr v)))

namespace SeparatedNonsimpleFreeData

omit [Fintype Nonsimple] [Fintype Vertex] in
/-- Actual quotient generation of any generated realized target by the
separated nonsimple labels is exactly top-trace generation by their data. -/
theorem target_mem_qClosure_iff_separatedDataFamilyTopTrace_eq_top
    (D : SeparatedNonsimpleFreeData tau)
    (C : Finset Nonsimple)
    (j : Nonsimple ⊕ (Vertex ⊕ Vertex))
    (E : SeparatedData.{u, v, w} (S := S) (J := J))
    (hE : IsGenerated E)
    (eE : realizedModuleCat E ≅
      (forget₂ (FGModuleCat.{w} (Algebra S J))
        (ModuleCat.{w} (Algebra S J))).obj (tau.obj j)) :
    j ∈ tau.qClosure
        (SeparatedSimpleLabelData.nonsimpleSupport
          (Vertex := Vertex) C) ↔
      TrivSqZeroExtSeparatedTrace.separatedDataFamilyTopTrace
          (fun i : {n : Nonsimple // n ∈ C} ↦ D.nonsimpleData i.1)
          E = ⊤ := by
  let T := SeparatedSimpleLabelData.nonsimpleSupport
    (Vertex := Vertex) C
  let e : {n : Nonsimple // n ∈ C} ≃ {i // i ∈ T} :=
    Equiv.Set.image Sum.inl (C : Set Nonsimple) Sum.inl_injective
  let X : {n : Nonsimple // n ∈ C} →
      ModuleCat.{w} (Algebra S J) :=
    fun i ↦ realizedModuleCat (D.nonsimpleData i.1)
  let X' : {n : Nonsimple // n ∈ C} →
      ModuleCat.{w} (Algebra S J) :=
    fun i ↦ (tau.obj (Sum.inl i.1)).obj
  let Y : ModuleCat.{w} (Algebra S J) :=
    realizedModuleCat E
  let Y' : ModuleCat.{w} (Algebra S J) :=
    (tau.obj j).obj
  rw [IndecomposableSkeleton.mem_qClosure_iff_trace_eq_top]
  rw [TrivSqZeroExtSeparatedTrace.skeletonTrace_eq_moduleFamilyTrace]
  have hreindex :=
    TrivSqZeroExtSeparatedTrace.moduleFamilyTrace_reindex
      e (TrivSqZeroExtSeparatedTrace.skeletonSelectedFamily tau T) Y'
  have hfamily :
      (fun i : {n : Nonsimple // n ∈ C} ↦
          TrivSqZeroExtSeparatedTrace.skeletonSelectedFamily tau T (e i)) =
        X' := by
    funext i
    rfl
  rw [← hreindex, hfamily]
  have hiso :=
    TrivSqZeroExtSeparatedTrace.moduleFamilyTrace_eq_top_iff_of_iso
      X X' Y Y' (fun i ↦ D.nonsimple_iso i.1) eE
  rw [← hiso]
  change realizedFamilyTrace
      (fun i : {n : Nonsimple // n ∈ C} ↦ D.nonsimpleData i.1)
      E = ⊤ ↔ _
  exact realizedFamilyTrace_eq_top_iff_separatedDataFamilyTopTrace_eq_top
    _ _ hE

omit [Fintype Nonsimple] [Fintype Vertex] in
/-- In particular, actual quotient generation of a separated nonsimple target
is its separated-data family top trace. -/
theorem nonsimple_mem_qClosure_iff_separatedDataFamilyTopTrace_eq_top
    (D : SeparatedNonsimpleFreeData tau)
    (C : Finset Nonsimple) (z : Nonsimple) :
    Sum.inl z ∈ tau.qClosure
        (SeparatedSimpleLabelData.nonsimpleSupport
          (Vertex := Vertex) C) ↔
      TrivSqZeroExtSeparatedTrace.separatedDataFamilyTopTrace
          (fun i : {n : Nonsimple // n ∈ C} ↦ D.nonsimpleData i.1)
          (D.nonsimpleData z) = ⊤ :=
  D.target_mem_qClosure_iff_separatedDataFamilyTopTrace_eq_top C
    (Sum.inl z) (D.nonsimpleData z) (D.nonsimple_generated z)
    (D.nonsimple_iso z)

omit [Fintype Nonsimple] [Fintype Vertex] in
/-- Every actual map from a nonsimple separated label to a free simple label
is zero. -/
theorem hom_nonsimple_free_eq_zero
    (D : SeparatedNonsimpleFreeData tau)
    (z : Nonsimple) (v : Vertex)
    (f : tau.obj (Sum.inl z) ⟶ tau.obj (Sum.inr (Sum.inr v))) :
    f = 0 := by
  let F := forget₂ (FGModuleCat.{w} (Algebra S J))
    (ModuleCat.{w} (Algebra S J))
  letI : Subsingleton (D.freeData v).top :=
    D.free_top_subsingleton v
  have hzero :
      (D.nonsimple_iso z).hom ≫ F.map f ≫ (D.free_iso v).inv = 0 :=
    realizedHom_eq_zero_of_generated_of_target_top_subsingleton
      (D.nonsimple_generated z) _
  have hmap : F.map f = 0 := by
    calc
      F.map f = (D.nonsimple_iso z).inv ≫
          ((D.nonsimple_iso z).hom ≫ F.map f ≫
            (D.free_iso v).inv) ≫
          (D.free_iso v).hom := by simp [Category.assoc]
      _ = 0 := by rw [hzero]; simp
  exact F.map_injective hmap

omit [Fintype Nonsimple] [Fintype Vertex] in
/-- No free simple lies in the actual quotient closure of a nonsimple-only
support. -/
theorem free_not_mem_qClosure_nonsimpleSupport
    (D : SeparatedNonsimpleFreeData tau)
    (C : Finset Nonsimple) (v : Vertex) :
    Sum.inr (Sum.inr v) ∉ tau.qClosure
      (SeparatedSimpleLabelData.nonsimpleSupport
        (Vertex := Vertex) C) := by
  rw [IndecomposableSkeleton.mem_qClosure_iff_trace_eq_top]
  have htrace :
      tau.trace
          (SeparatedSimpleLabelData.nonsimpleSupport
            (Vertex := Vertex) C)
          (tau.obj (Sum.inr (Sum.inr v))) = ⊥ := by
    apply tau.trace_eq_bot_of_forall_hom_eq_zero
    intro i hi f
    rcases hi with ⟨z, -, rfl⟩
    exact D.hom_nonsimple_free_eq_zero z v f
  rw [htrace]
  letI : Nontrivial (tau.obj (Sum.inr (Sum.inr v))) :=
    (tau.indecomposable (Sum.inr (Sum.inr v))).nontrivial
  exact bot_ne_top

end SeparatedNonsimpleFreeData

namespace OriginalNonsimpleLabelData

variable [IsSemisimpleRing S]
variable [IsNoetherianRing (TrivSqZeroExt S J)]
variable [DecidableEq Nonsimple] [DecidableEq Vertex]
variable
  {sigma : IndecomposableSkeleton.{max u v, max x y, w}
    (TrivSqZeroExt S J) (Nonsimple ⊕ Vertex)}

/-- Objectwise alignment of the separated nonsimple and covered-simple
realizations with the separated data extracted from the original skeleton. -/
structure SeparatedCoreAlignment
    (sigma : IndecomposableSkeleton.{max u v, max x y, w}
      (TrivSqZeroExt S J) (Nonsimple ⊕ Vertex))
    (tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex)))
    (G : SeparatedNonsimpleFreeData tau) where
  nonsimple_data_eq (z : Nonsimple) :
    G.nonsimpleData z =
      TrivSqZeroExtSeparatedCorrespondence.moduleSeparatedData
        (S := S) (J := J) ((sigma.obj (Sum.inl z)).obj)
  covered_iso (v : Vertex) :
    realizedModuleCat
        (TrivSqZeroExtSeparatedCorrespondence.moduleSeparatedData
          (S := S) (J := J) ((sigma.obj (Sum.inr v)).obj)) ≅
      (forget₂ (FGModuleCat.{w} (Algebra S J))
        (ModuleCat.{w} (Algebra S J))).obj
          (tau.obj (Sum.inr (Sum.inl v)))

namespace SeparatedCoreAlignment

omit [Fintype Nonsimple] [Fintype Vertex]
    [DecidableEq Nonsimple] [DecidableEq Vertex] in
/-- The actual separated nonsimple closure has the same generation predicate
as the original nonsimple top trace. -/
theorem b_nonsimple_core
    {tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex))}
    {G : SeparatedNonsimpleFreeData tau}
    (A : SeparatedCoreAlignment sigma tau G)
    (C : Finset Nonsimple) (z : Nonsimple) :
    Sum.inl z ∈ tau.qClosure
          (SeparatedSimpleLabelData.nonsimpleSupport
            (Vertex := Vertex) C) ↔
      Generates (sigma := sigma) C z := by
  rw [G.nonsimple_mem_qClosure_iff_separatedDataFamilyTopTrace_eq_top]
  unfold Generates
  rw [TrivSqZeroExtSeparatedTrace.moduleFamilyTopTrace_eq_separatedDataFamilyTopTrace]
  rw [A.nonsimple_data_eq z]
  simp_rw [A.nonsimple_data_eq]

omit [Fintype Nonsimple] [DecidableEq Nonsimple] in
/-- The actual covered simple is forced by precisely the original
nonsimple-support top trace. -/
theorem b_covered_core
    {tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex))}
    {G : SeparatedNonsimpleFreeData tau}
    (A : SeparatedCoreAlignment sigma tau G)
    (C : Finset Nonsimple) (v : Vertex) :
    Sum.inr (Sum.inl v) ∈ tau.qClosure
          (SeparatedSimpleLabelData.nonsimpleSupport
            (Vertex := Vertex) C) ↔
      v ∈ forcedTop (sigma := sigma) C := by
  let E := TrivSqZeroExtSeparatedCorrespondence.moduleSeparatedData
    (S := S) (J := J) ((sigma.obj (Sum.inr v)).obj)
  calc
    Sum.inr (Sum.inl v) ∈ tau.qClosure
          (SeparatedSimpleLabelData.nonsimpleSupport
            (Vertex := Vertex) C) ↔
        TrivSqZeroExtSeparatedTrace.separatedDataFamilyTopTrace
            (fun i : {z : Nonsimple // z ∈ C} ↦ G.nonsimpleData i.1)
            E = ⊤ :=
      G.target_mem_qClosure_iff_separatedDataFamilyTopTrace_eq_top C
        (Sum.inr (Sum.inl v)) E
        (TrivSqZeroExtSeparatedCorrespondence.moduleSeparatedData_isGenerated
          (S := S) (J := J) ((sigma.obj (Sum.inr v)).obj))
        (A.covered_iso v)
    _ ↔ TrivSqZeroExtSeparatedTrace.moduleFamilyTopTrace
          (fun i : {z : Nonsimple // z ∈ C} ↦
            (sigma.obj (Sum.inl i.1)).obj)
          (sigma.obj (Sum.inr v)).obj = ⊤ := by
      rw [TrivSqZeroExtSeparatedTrace.moduleFamilyTopTrace_eq_separatedDataFamilyTopTrace]
      simp_rw [A.nonsimple_data_eq]
      rfl
    _ ↔ v ∈ forcedTop (sigma := sigma) C :=
      (mem_forcedTop_iff_moduleFamilyTopTrace_eq_top C v).symm

end SeparatedCoreAlignment

/-- The paired closure interface with the free-simple law discharged by
generated separated realization.  Only the common nonsimple and covered-top
comparisons remain as inputs. -/
noncomputable def toPairedClosureMembershipOfSeparatedRealization
    (D : OriginalNonsimpleLabelData Nonsimple Vertex sigma)
    (tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex)))
    (E : SeparatedSimpleLabelData tau)
    (G : SeparatedNonsimpleFreeData tau)
    (b_nonsimple_core :
      ∀ (C : Finset Nonsimple) (z : Nonsimple),
        Sum.inl z ∈ tau.qClosure
            (SeparatedSimpleLabelData.nonsimpleSupport
              (Vertex := Vertex) C) ↔
          Generates (sigma := sigma) C z)
    (b_covered_core :
      ∀ (C : Finset Nonsimple) (v : Vertex),
        Sum.inr (Sum.inl v) ∈ tau.qClosure
            (SeparatedSimpleLabelData.nonsimpleSupport
              (Vertex := Vertex) C) ↔
          v ∈ forcedTop (sigma := sigma) C) :
    PairedClosureMembership sigma.qClosure tau.qClosure :=
  D.toPairedClosureMembershipOfSeparatedSimple tau E
    b_nonsimple_core b_covered_core
    (fun C v ↦ G.free_not_mem_qClosure_nonsimpleSupport C v)

/-- Once the objectwise separated realization is aligned with the original
data, all five pointwise closure laws are automatic. -/
noncomputable def toPairedClosureMembershipOfAlignment
    (D : OriginalNonsimpleLabelData Nonsimple Vertex sigma)
    (tau : IndecomposableSkeleton.{max u v, max x y, w}
      (Algebra S J) (Nonsimple ⊕ (Vertex ⊕ Vertex)))
    (E : SeparatedSimpleLabelData tau)
    (G : SeparatedNonsimpleFreeData tau)
    (A : SeparatedCoreAlignment sigma tau G) :
    PairedClosureMembership sigma.qClosure tau.qClosure :=
  D.toPairedClosureMembershipOfSeparatedRealization tau E G
    A.b_nonsimple_core A.b_covered_core

end OriginalNonsimpleLabelData

end OpConjecture.RadicalSquareZero
